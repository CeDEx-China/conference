{
    "name": "Jekyll GitHub Pages",
    "image": "mcr.microsoft.com/devcontainers/jekyll:latest",
    "forwardPorts": [4000, 35729],
    "portsAttributes": {
        "4000": {
            "label": "Jekyll",
            "onAutoForward": "notify"
        },
        "35729": {
            "label": "LiveReload",
            "onAutoForward": "ignore"
        }
    },
    "postCreateCommand": "bundle install && bundle exec jekyll serve --host 0.0.0.0 --livereload --force_polling",
    "customizations": {
        "vscode": {
            "extensions": [
                "shopify.ruby-lsp",
                "sissel.shopify-liquid"
            ]
        }
    }
}
